    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^9.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
